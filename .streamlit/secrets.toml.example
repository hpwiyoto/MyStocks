# Copy this file to .streamlit/secrets.toml (same folder) and fill in the
# real values below -- secrets.toml itself is gitignored, never committed.
# See README.md's "Setup Login" section for how to get each value.

[auth]
# Local dev default (matches `streamlit run app/Home.py`'s default port).
# On the VPS, change this to your real domain/IP, e.g.
# "http://<VPS-IP>:8501/oauth2callback" -- and update the Authorized
# redirect URI in Google Cloud Console to match, exactly (scheme+host+port).
redirect_uri = "http://localhost:8501/oauth2callback"

# Any long random string -- generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_RANDOM_STRING"

# From Google Cloud Console -> APIs & Services -> Credentials -> your
# OAuth 2.0 Client ID (Web application).
client_id = "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[gmail]
# The Gmail account that SENDS the "new signup" notification -- can be the
# same as the admin's own address (heru.purbowiyoto@gmail.com) or a
# separate sending account, your choice.
address = "heru.purbowiyoto@gmail.com"
# NOT your normal Gmail password -- a 16-character "App Password" (Google
# blocks plain-password SMTP login). See README for how to generate one.
app_password = "REPLACE_WITH_A_16_CHAR_APP_PASSWORD"
# Optional -- who receives the notification, if different from `address`
# above. Defaults to `address` itself when omitted.
# notify_to = "heru.purbowiyoto@gmail.com"
