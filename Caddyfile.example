# Copy to `Caddyfile` (same folder) and replace the placeholder domain
# with your VM's actual sslip.io hostname (or a real domain, if you have
# one) -- see README's "Deploy ke VPS (VM kecil / gratis)" section.
# Caddy handles HTTPS certificate issuance/renewal automatically; nothing
# else to configure.

REPLACE_WITH_YOUR_DOMAIN.sslip.io {
    reverse_proxy app:8501
}
