# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mystocks
MYSQL_USER=
MYSQL_PASSWORD=
# Only needed for docker-compose (initializes the MySQL container) -- not
# used by the app/pipeline itself, which connects as MYSQL_USER above.
MYSQL_ROOT_PASSWORD=

# Optional: Fase 6 pipeline-failure alerts via Telegram. Leave blank to
# fall back to log-only (see scripts/monitor.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
