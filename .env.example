# Local/dev database: SQLite, zero-config -- nothing below is required to
# just run `start`. The file lives at data/mystocks.db by default; only set
# this if you want it somewhere else.
# MYSTOCKS_DB_PATH=C:\path\to\somewhere\mystocks.db

# Optional: Fase 6 pipeline-failure alerts via Telegram. Leave blank to
# fall back to log-only (see scripts/monitor.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Production (VPS) only -- NOT used by the local SQLite setup above ---
# docker-compose.yml's `mysql`/`app`/`scheduler` services (Fase 6 deploy)
# still run on MySQL; a VPS deployment needs its own .env with these set.
# See README.md's "Production Deployment (Fase 6)" section.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=mystocks
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
