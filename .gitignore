# Environment
.env
.venv/
venv/
docker-compose.override.yml

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Logs
*.log

# Data & model artifacts
data/*
!data/.gitkeep
models/*.pkl
models/*.joblib
models/*.txt
models/*.json
# Committed production model artifact (small, deliberately versioned --
# workflow is: train, download/copy, commit here). Only the CURRENT
# production version is un-ignored -- superseded versions (v1-v3) are kept
# locally for rollback but not carried forward in git, same as any other
# build artifact. Un-ignore explicitly rather than dropping the
# models/*.json rule entirely, so future ad-hoc experiment dumps in models/
# don't get committed by accident.
!models/.gitkeep
!models/direction_xgboost_v5.json
!models/direction_xgboost_v5_metadata.json
# Separate menu (Turnaround Screener), not a superseded version of the
# swing model above -- both stay un-ignored together.
!models/turnaround_xgboost_v1.json
!models/turnaround_xgboost_v1_metadata.json

# OS / editor
.DS_Store
.vscode/

# Claude Code personal settings (permission mode etc.) -- not for the team
.claude/settings.local.json
