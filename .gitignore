# Environment
.env
.venv/
venv/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Logs
*.log

# Data & model artifacts
data/*
!data/.gitkeep
models/*.pkl
models/*.joblib
models/*.txt
models/*.json
# Committed production model artifacts (small, deliberately versioned --
# workflow is: train in Colab, download, commit here). Un-ignore explicitly
# rather than dropping the models/*.json rule entirely, so future ad-hoc
# experiment dumps in models/ don't get committed by accident.
!models/.gitkeep
!models/direction_xgboost_v1.json
!models/direction_xgboost_v1_metadata.json

# OS / editor
.DS_Store
.vscode/
